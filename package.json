{
  "name": "adminhub-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter \"@adminhub/*\" dev",
    "dev:web": "pnpm --filter @adminhub/web dev",
    "dev:api": "pnpm --filter @adminhub/api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint"
  },
  "packageManager": "pnpm@12.9.1"
}
